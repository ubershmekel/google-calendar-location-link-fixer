{
  "manifest_version": 3,
  "name": "Calendar Link Fixer",
  "description": "Opens Google Calendar location links in a new tab.",
  "version": "1.0",
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon128.png"],
      "matches": ["https://calendar.google.com/*"]
    }
  ]
}
